APP_ENV=production
APP_SECRET_KEY=replace-this-with-a-long-random-value-at-least-32-chars
SESSION_SECRET_KEY=replace-with-a-strong-random-session-secret-at-least-32-chars

DATABASE_URL=postgresql+psycopg://rfp_user:rfp_password@localhost:5432/rfp_architect
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data

LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=

# Authentication settings
# Supported values: dev, session, oidc
AUTH_MODE=session

# OIDC/SSO parameters (Required ONLY if AUTH_MODE=oidc)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
