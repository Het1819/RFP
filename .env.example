APP_ENV=production
APP_SECRET_KEY=replace-this-with-a-long-random-value-at-least-32-chars
SESSION_SECRET_KEY=replace-with-a-strong-random-session-secret-at-least-32-chars

DATABASE_URL=postgresql+psycopg://rfp_user:rfp_password@localhost:5432/rfp_architect
REDIS_URL=redis://localhost:6379/0

# Server-side session store (Phase A2). Falls back to REDIS_URL if unset.
SESSION_REDIS_URL=
SESSION_COOKIE_NAME=rfp_session
SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Login throttling (Phase A2). Must be a distinct strong secret in
# production -- do not reuse APP_SECRET_KEY or SESSION_SECRET_KEY.
LOGIN_THROTTLE_SECRET=replace-with-a-strong-random-throttle-secret-at-least-32-chars
LOGIN_THROTTLE_ACCOUNT_IP_MAX=5
LOGIN_THROTTLE_ACCOUNT_IP_WINDOW_SECONDS=900
LOGIN_THROTTLE_IP_MAX=25
LOGIN_THROTTLE_IP_WINDOW_SECONDS=900
LOGIN_THROTTLE_ACCOUNT_MAX=20
LOGIN_THROTTLE_ACCOUNT_WINDOW_SECONDS=3600
LOGIN_THROTTLE_MAX_COOLDOWN_SECONDS=300

# Queue-backed Processing Config
QUEUE_ENABLED=false
JOB_MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=300
JOB_RETRY_BACKOFF_SECONDS=5

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data

LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=

# Authentication settings
# Supported values: dev, session, oidc
AUTH_MODE=session

# OIDC/SSO parameters (Required ONLY if AUTH_MODE=oidc)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
