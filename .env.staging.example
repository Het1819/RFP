# RFP Architect MVP - Staging Environment Configuration Template
# Copy to .env in your staging environment and replace placeholders with secure secrets.

# 1. Environment & Secret Keys
APP_ENV=staging
DEBUG=false
APP_SECRET_KEY=replace-with-strong-app-secret-32-chars-minimum
SESSION_SECRET_KEY=replace-with-strong-session-secret-32-chars-minimum

# 2. Database & Cache
# Point to your dedicated staging PostgreSQL instance
DATABASE_URL=postgresql+psycopg://rfp_user:rfp_password@localhost:5432/rfp_architect_staging

# Point to your dedicated staging Redis instance
REDIS_URL=redis://localhost:6379/0

# 3. Asynchronous Task Queue
QUEUE_ENABLED=true

# 4. LLM Configuration
# "fake" (FakeLLMProvider) is for local/CI offline runs ONLY. It is
# rejected at startup in any environment other than development/local/test
# (see app/core/config.py Settings.validate_production_hardening).
# Staging/pilot MUST use "anthropic" with an explicit LLM_MODEL and a real
# ANTHROPIC_API_KEY (prefer ANTHROPIC_API_KEY_FILE with Docker secrets).
# OpenAI is NOT implemented in this codebase -- do not set an OPENAI_*
# variable; there is no code path that reads one.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# 5. Observability & Telemetry
ENABLE_LLM_TELEMETRY=true
ENABLE_LLM_DEBUG_PAYLOAD_LOGGING=false
LOG_LEVEL=INFO

# 6. Storage & Uploads
# Path to staging directory for uploaded RFP files and evidence source documents
UPLOAD_DIR=storage/uploads
BACKUP_DIR=storage/backups

# 7. Authentication Mode (session or oidc)
AUTH_MODE=session

# 8. OIDC Configuration (Only required if AUTH_MODE=oidc)
OIDC_CLIENT_ID=placeholder-staging-client-id
OIDC_CLIENT_SECRET=placeholder-staging-client-secret
OIDC_DISCOVERY_URL=https://auth.staging.yourorg.com/.well-known/openid-configuration
OIDC_REDIRECT_URI=https://rfp-staging.yourorg.com/auth/callback
